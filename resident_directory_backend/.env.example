# PostgreSQL connection – use the env var names from the database container
# POSTGRES_URL can be either:
#   - A full DSN: postgresql://user:pass@host:port/dbname
#   - A hostname only (e.g. "localhost") – remaining vars will build the DSN
POSTGRES_URL=localhost
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
# Database container listens on port 5000 (mapped from internal 5432)
POSTGRES_PORT=5000

# JWT configuration
# SECRET_KEY must be set to a long random string in production
SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
